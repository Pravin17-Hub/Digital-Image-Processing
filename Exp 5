clc;
clear;
close all;

I = imread("peppers.png");
grayImage = rgb2gray(I);

gaussianNoise = imnoise(grayImage,"gaussian");
poissonNoise = imnoise(grayImage,"poisson");

subplot(1,3,1);
imshow(grayImage);
title("Original Image");

subplot(1,3,2);
imshow(gaussianNoise);
title("Gaussian Noise");

subplot(1,3,3);
imshow(poissonNoise);
title("Poisson Noise");
