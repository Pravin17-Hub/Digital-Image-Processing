clc;
clear;
close all;

I = imread("peppers.png");
grayImage = rgb2gray(I);
binaryImage = imbinarize(grayImage);

se = strel("disk",3);

dilatedImage = imdilate(binaryImage,se);
erodedImage = imerode(binaryImage,se);

subplot(1,3,1);
imshow(binaryImage);
title("Binary Image");

subplot(1,3,2);
imshow(dilatedImage);
title("Dilation");

subplot(1,3,3);
imshow(erodedImage);
title("Erosion");
